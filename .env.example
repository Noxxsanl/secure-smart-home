# Biến cho docker compose (compose.yaml, compose.prod.yaml).
# Copy thành .env (đã gitignore) rồi đặt mật khẩu mạnh — KHÔNG commit .env.
#   openssl rand -base64 24
# Lưu ý: POSTGRES_* chỉ áp dụng khi volume pg_data được khởi tạo lần đầu (infra/postgres/init/00_init.sh).
# Đổi mật khẩu trên volume đã có: ALTER ROLE (xem docs/guides/CHAY_LOCAL.md).

# Superuser `postgres` — chỉ để quản trị, backend KHÔNG dùng.
POSTGRES_PASSWORD=change_me_superuser
POSTGRES_DB=secure_smart_home_iot
# Role ứng dụng (không phải superuser): sở hữu database và các bảng, là tài khoản backend dùng.
POSTGRES_APP_USER=secure_smart_home_app
POSTGRES_APP_PASSWORD=change_me
