# Biến cho docker compose (docker-compose.yml, docker-compose.prod.yml).
# Copy thành .env (đã gitignore) rồi đặt mật khẩu mạnh — KHÔNG commit .env.
#   openssl rand -base64 24
# Lưu ý: MYSQL_* chỉ áp dụng khi volume mysql_data được khởi tạo lần đầu.
# Đổi mật khẩu trên volume đã có: ALTER USER (xem docs/11_CHAY_LOCAL.md).

MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=secure_smart_home_iot
MYSQL_USER=secure_smart_home_app
MYSQL_PASSWORD=change_me
