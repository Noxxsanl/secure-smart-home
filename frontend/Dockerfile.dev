# Image dev dùng chung cho 3 app — chọn app bằng build arg APP (admin|operator|user).
# Source được bind-mount vào /app, node_modules nằm trong anonymous volume: đổi phụ thuộc (thêm
# package/module) thì chạy `docker compose up --build --renew-anon-volumes` (make dev) để volume
# lấy node_modules mới từ image thay vì giữ bản cũ.

# Chỉ gom package.json của mọi workspace + lockfile (xem Dockerfile).
FROM node:20-alpine AS manifests
WORKDIR /src
COPY . .
RUN find . -name package.json -not -path "*/node_modules/*" | while read -r f; do \
      mkdir -p "/out/$(dirname "$f")" && cp "$f" "/out/$f"; \
    done \
  && cp package-lock.json /out/

FROM node:20-alpine
WORKDIR /app
COPY --from=manifests /out ./
RUN npm install
ARG APP=admin
ENV APP=${APP} NEXT_TELEMETRY_DISABLED=1
EXPOSE 3000
CMD ["sh", "-c", "npx next dev \"apps/$APP\" -H 0.0.0.0 -p 3000"]
