# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.*.local

# Build outputs
dist/
.next/

# Logs
npm-debug.log*
*.log

# ESP-IDF (docs/guides/ESP_IDF_BUILD.md §7.3) — nvs_*.csv/bin chứa WiFi + secret thiết bị
firmware/**/build/
firmware/**/build_*/
firmware/**/sdkconfig
firmware/**/sdkconfig.old
firmware/**/managed_components/
# Node: thư viện registry đặt sẵn trong components/ như Gateway (components/lvgl__lvgl, ~99 MB, tải lại được).
# Lock khi đó trỏ tới components/*__* bằng đường dẫn tuyệt đối của từng máy → sinh lại khi build, không commit.
firmware/esp32_s3_firmware_node/components/*__*/
firmware/esp32_s3_firmware_node/dependencies.lock
firmware/**/certs/
firmware/**/nvs_*.csv
firmware/**/nvs_*.bin

# MQTT TLS — sinh bởi infra/pki/gen_mqtt_certs.sh (có khoá riêng CA/server)
infra/mosquitto/certs/*
!infra/mosquitto/certs/.gitkeep
firmware/gateway-node/include/mqtt_ca_cert.h

