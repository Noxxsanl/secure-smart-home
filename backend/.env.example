PORT=5000

# Database (PostgreSQL 16)
# Trong Docker compose các biến DB_* được ghi đè (DB_HOST=postgres, DB_PORT=5432).
# Chạy backend NGOÀI Docker mà nối vào container postgres của compose.yaml (cách khuyến nghị):
# container chỉ mở 127.0.0.1:5433 -> 5432 nên DB_PORT=5433. Dùng PostgreSQL cài trực tiếp trên máy thì đổi 5432.
# DB_USER/DB_PASS/DB_NAME = POSTGRES_APP_USER/POSTGRES_APP_PASSWORD/POSTGRES_DB trong .env gốc
# (không dùng superuser postgres).
DB_HOST=localhost
DB_PORT=5433
DB_USER=secure_smart_home_app
DB_PASS=change_me
DB_NAME=secure_smart_home_iot

# JWT (min 32 chars – server will crash on startup if shorter)
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars

# MQTT Broker 2 (Gateway → Backend layer) — MQTT over TLS
# Local dev: localhost:8883  |  Docker: overridden to mqtt-broker-2:8883 in compose
MQTT_HOST=localhost
MQTT_PORT=8883
# CA của broker, sinh bằng infra/pki/gen_mqtt_certs.sh (đường dẫn tương đối tính từ backend/)
MQTT_CA_FILE=../infra/mosquitto/certs/ca.crt

# CORS – URL của frontend (qua Nginx khi chạy Docker; dùng :3000 nếu chạy thẳng)
FRONTEND_URL=http://localhost

# ---- V2 (tất cả TUỲ CHỌN, có mặc định an toàn; bỏ comment để dùng) ----
# Secret riêng ký access token Mobile / chữ ký QR kích hoạt (≥ 32 ký tự). Bỏ trống = dẫn xuất từ JWT_SECRET.
# MOBILE_JWT_SECRET=
# ACTIVATION_QR_SECRET=
# Đứng sau reverse proxy (nginx)? Đặt số hop proxy ("1" khi chỉ có nginx) HOẶC danh sách subnet/IP của proxy
# ("172.18.0.0/16" hoặc "loopback,172.18.0.0/16"). Mặc định false = không tin X-Forwarded-For → rate limit đếm
# theo IP socket (sau nginx sẽ gộp mọi client thành 1 IP). KHÔNG dùng "true" (bị bỏ qua vì giả IP được).
# TRUST_PROXY=1
# Cookie có cờ Secure (mặc định true khi NODE_ENV=production)
# COOKIE_SECURE=false
# Simulator thiết bị ảo + seed dữ liệu demo (mặc định true khi NODE_ENV khác production)
# DEVICE_SIMULATOR=true
# SEED_DEMO_DATA=true
# Hạn Activation Code (ngày), thư mục lưu firmware upload, số ngày giữ sensor_data
# ACTIVATION_CODE_TTL_DAYS=180
# FIRMWARE_STORAGE_DIR=storage/firmware
# TELEMETRY_RETENTION_DAYS=8

# Tài khoản admin cho `npm run seed` (production: bắt buộc, mật khẩu ≥ 12 ký tự).
# Dev không cần: seed demo (SEED_DEMO_DATA) tự tạo admin — tài khoản demo xem docs/guides/CHAY_LOCAL.md.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_admin_password
