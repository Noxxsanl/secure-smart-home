# Cấu hình AI Agent — chép thành agent/.env rồi điền giá trị (agent/.env đã gitignore, KHÔNG commit).
# Mọi biến đều đọc bởi src/smarthome_agent/config.py; trong Docker có thể truyền thẳng bằng biến môi trường.

# ---- Dịch vụ ----
# development | production (production: bắt buộc có OPENAI_API_KEY, tắt /docs)
AGENT_ENV=development
AGENT_HOST=0.0.0.0
AGENT_PORT=8000
# critical | error | warning | info | debug
AGENT_LOG_LEVEL=info
# Origin được gọi agent từ trình duyệt, ngăn cách bằng dấu phẩy (app user :3003)
AGENT_CORS_ORIGINS=http://localhost:3003

# ---- LLM: OpenAI ----
# Lấy tại https://platform.openai.com/api-keys. Không log, không in key ở bất kỳ đâu (bất biến số 2).
OPENAI_API_KEY=
# Model gọi tool; đổi theo kết quả bộ eval/ (kiểm tra tên model còn hỗ trợ trên trang OpenAI)
OPENAI_MODEL=gpt-5-mini
# Bỏ trống = api.openai.com. Đặt khi dùng endpoint tương thích OpenAI (VD Ollama: http://localhost:11434/v1)
OPENAI_BASE_URL=
# Tuỳ chọn, chỉ cần khi key thuộc nhiều organization/project
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
# Quá thời gian thì chuyển sang fallback (đề xuất §8.2: 15 giây)
OPENAI_TIMEOUT_S=15
OPENAI_MAX_OUTPUT_TOKENS=1024

# ---- Giới hạn vòng lặp và chi phí (đề xuất §8.2, §11.3) ----
AGENT_MAX_TOOL_ROUNDS=6
AGENT_MAX_CLARIFICATIONS=2
AGENT_RATE_LIMIT_PER_MIN=10
AGENT_DAILY_LIMIT_PER_HOME=200
AGENT_DAILY_BUDGET_USD=2
# true: lệnh R1 nói rõ chạy ngay + Hoàn tác 10 giây; false: mọi lệnh đều qua thẻ xác nhận (câu hỏi QA3)
AGENT_ALLOW_R1_AUTO=true

# ---- Backend ----
# Agent gọi /api/mobile/** bằng chính Bearer token của người dùng — không có tài khoản hệ thống (đề xuất §6).
# Chạy trong compose: http://backend:5000
BACKEND_URL=http://localhost:5000
BACKEND_TIMEOUT_S=10

# ---- Nhận dạng giọng nói (STT) ----
# none | openai | whisper_local
STT_PROVIDER=none
STT_LANGUAGE=vi
# Dùng khi STT_PROVIDER=openai (dùng chung OPENAI_API_KEY)
STT_OPENAI_MODEL=whisper-1
# Dùng khi STT_PROVIDER=whisper_local: tiny | base | small | medium | large-v3
STT_WHISPER_MODEL=small
STT_MAX_AUDIO_SECONDS=30
