# Cấu hình AI Agent — chép thành agent/.env rồi điền giá trị (agent/.env đã gitignore, KHÔNG commit).
# Mọi biến đều đọc bởi src/smarthome_agent/config.py; trong Docker có thể truyền thẳng bằng biến môi trường.

# ---- Dịch vụ ----
# development | production (production: bắt buộc có OPENAI_API_KEY, tắt /docs)
AGENT_ENV=development
AGENT_HOST=0.0.0.0
AGENT_PORT=8000
# critical | error | warning | info | debug
AGENT_LOG_LEVEL=info
# Origin được gọi agent từ trình duyệt, ngăn cách bằng dấu phẩy (app user :3003)
AGENT_CORS_ORIGINS=http://localhost:3003

# ---- LLM: OpenAI ----
# Lấy tại https://platform.openai.com/api-keys. Không log, không in key ở bất kỳ đâu (bất biến số 2).
OPENAI_API_KEY=
# Model gọi tool; đổi theo kết quả bộ eval/ (kiểm tra tên model còn hỗ trợ trên trang OpenAI)
OPENAI_MODEL=gpt-5-mini
# Bỏ trống = api.openai.com. Đặt khi dùng endpoint tương thích OpenAI (VD Ollama: http://localhost:11434/v1)
OPENAI_BASE_URL=
# Tuỳ chọn, chỉ cần khi key thuộc nhiều organization/project
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
# Quá thời gian thì chuyển sang fallback (đề xuất §8.2: 15 giây)
OPENAI_TIMEOUT_S=15
# Model reasoning (gpt-5-*) tính cả token suy luận vào hạn mức này — đừng đặt quá thấp
OPENAI_MAX_OUTPUT_TOKENS=2048
# Mức suy luận của planner (reasoning.effort): default | none | minimal | low | medium | high.
# Thấp hơn = nhanh + rẻ hơn. default = KHÔNG gửi tham số reasoning (model tự chọn mức mặc định, thường
# medium → chậm). Chọn mức thấp nhất vẫn đạt chất lượng bằng eval/run_eval.py --effort <mức>.
OPENAI_REASONING_EFFORT=low

# ---- Giới hạn vòng lặp và chi phí (đề xuất §8.2, §11.3) ----
AGENT_MAX_TOOL_ROUNDS=6
AGENT_MAX_CLARIFICATIONS=2
AGENT_RATE_LIMIT_PER_MIN=10
AGENT_DAILY_LIMIT_PER_HOME=200
# Thời hạn tổng một request (STT + planner + backend), giây, tối thiểu 10. Giữ nhỏ hơn proxy_read_timeout
# của nginx (60 s). Còn < 5 giây mà chưa tạo yêu cầu thì dừng, không đặt lịch.
AGENT_REQUEST_TIMEOUT_S=40

# ---- Backend ----
# Agent không có tài khoản hệ thống: mỗi lời gọi /api/service/agent/** mang BACKEND_SERVICE_TOKEN (chứng
# minh là agent) + credential của chính người đang chat (cookie sh_user hoặc Bearer) để backend kiểm quyền.
# Chạy trong compose: http://backend:5000
BACKEND_URL=http://localhost:5000
BACKEND_TIMEOUT_S=10
# Token kênh dịch vụ của backend (/api/service/**). PHẢI trùng giá trị SERVICE_API_TOKEN trong backend/.env
# (≥ 32 ký tự). Dùng để (1) lấy context nhà + tạo request cho Trợ lý, (2) gửi số liệu mỗi lần gọi LLM/STT
# (token, độ trễ, lỗi — KHÔNG có nội dung chat) cho tab "AI Usage". Bỏ trống = Trợ lý trả 503 AGENT_UNAVAILABLE.
BACKEND_SERVICE_TOKEN=

# ---- Nhận dạng giọng nói (STT) ----
# none (tắt: /voice trả 503 STT_DISABLED) | openai | whisper_local (chưa hiện thực)
# Giọng nói của người dùng được gửi tới OpenAI để chuyển thành chữ, agent không lưu audio.
STT_PROVIDER=openai
STT_LANGUAGE=vi
# Dùng khi STT_PROVIDER=openai (dùng chung OPENAI_API_KEY; thiếu key ở development thì chỉ báo 503, không crash)
STT_OPENAI_MODEL=gpt-4o-mini-transcribe
# Dùng khi STT_PROVIDER=whisper_local: tiny | base | small | medium | large-v3
STT_WHISPER_MODEL=small
STT_MAX_AUDIO_SECONDS=30
