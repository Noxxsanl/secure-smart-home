# Chỉ làm việc với ESP-IDF — bỏ bản Arduino và firmware .bin dựng sẵn của Waveshare
/Arduino/
/Firmware/

# ESP-IDF build output
build/
sdkconfig
sdkconfig.old

# Component từ registry (tải lại theo idf_component.yml khi `idf.py build`; gateway: components/drivers/)
managed_components/
ESP-IDF/*/components/*__*/
# Lock trỏ tới components/*__* bằng đường dẫn tuyệt đối của từng máy — sinh lại khi build
ESP-IDF/*/dependencies.lock

# Editor / tooling
.vscode/
.devcontainer/
.cache/
.clangd
compile_commands.json
