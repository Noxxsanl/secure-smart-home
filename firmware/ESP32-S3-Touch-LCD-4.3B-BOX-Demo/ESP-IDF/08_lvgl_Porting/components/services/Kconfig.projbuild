# Chỉ tuỳ chọn KHÔNG bí mật. device_id, secret, WiFi, Local AP, danh sách node nằm trong NVS (README).
menu "Gateway S3: services"

    config GW_MQTT_URI_DEFAULT
        string "MQTT Broker 2 mặc định (NVS cloud/mqtt_uri ghi đè)"
        default "mqtts://192.168.1.100:8883"
        help
            Host phải nằm trong SAN của chứng chỉ broker (infra/pki/gen_mqtt_certs.sh, docs/guides/MQTT_TLS.md).

    config GW_API_URL_DEFAULT
        string "Địa chỉ Backend mặc định (NVS cloud/api_url ghi đè)"
        default "https://192.168.1.100"
        help
            Dùng cho POST /api/device/data (đường dự phòng khi MQTT mất kết nối) và gửi ảnh camera.

    config GW_SNTP_SERVER
        string "Máy chủ NTP"
        default "pool.ntp.org"

    config GW_LOCAL_AP_CHANNEL
        int "Kênh Local AP khi chưa nối router"
        range 1 13
        default 1
        help
            Khi đã nối router, Local AP và ESP-NOW tự chuyển sang kênh của router (1 radio dùng chung).

    config GW_LOCAL_AP_MAX_CONN
        int "Số camera tối đa trên Local AP"
        range 1 4
        default 2

    config GW_HEARTBEAT_INTERVAL_S
        int "Chu kỳ heartbeat Gateway → Server (giây)"
        range 10 300
        default 30

    config GW_NODE_ACK_TIMEOUT_MS
        int "Thời gian chờ CMD_ACK của node (ms)"
        range 500 4500
        default 3000
        help
            IOT_NODE_NETWORK §6.3: node im lặng 3 giây thì Gateway trả ack error. Backend chờ ack 5 giây.

    config GW_NODE_OFFLINE_S
        int "Coi node mất kết nối sau bao nhiêu giây không thấy gói"
        range 30 600
        default 90

    config GW_MOTION_SNAPSHOT_WAIT_S
        int "Chờ ảnh sau sự kiện chuyển động (giây)"
        range 1 30
        default 5
        help
            Hết thời gian mà camera chưa gửi ảnh thì publish camera/event không kèm snapshot_id.

    choice GW_CAMERA_LIVE_FRAMESIZE
        prompt "Độ phân giải luồng camera trên màn hình"
        default GW_CAMERA_LIVE_FS_VGA
        help
            IOT_NODE_NETWORK §5.4. ESP32-S3 không có bộ giải mã JPEG phần cứng: Gateway giải nén bằng TJpgDec
            trong ROM, nên số khung/giây phụ thuộc chủ yếu vào độ phân giải.

        config GW_CAMERA_LIVE_FS_VGA
            bool "VGA 640x480 (nét, ít khung/giây hơn)"
        config GW_CAMERA_LIVE_FS_QVGA
            bool "QVGA 320x240, phóng x2 lên 640x480 (mượt hơn, kém nét)"
    endchoice

    config GW_CAMERA_LIVE_QUALITY
        int "Chất lượng JPEG của luồng (10-30, nhỏ hơn = đẹp hơn, khung nặng hơn)"
        range 10 30
        default 12

    config GW_CAMERA_LIVE_ALWAYS
        bool "Luôn hiện xem trực tiếp khi camera trực tuyến"
        default n
        help
            Màn hình xem trực tiếp mở ngay khi camera vào Local AP và không tự đóng: luồng rớt thì tự nối lại; camera
            mất hẳn thì về màn hình chính, tự mở lại khi camera vào lại (thử sau 5 s, lùi dần tới 60 s nếu hỏng liên
            tiếp). Đóng bằng nút trên màn hình (khi bật cảm ứng) thì 2 phút sau mới tự mở lại.
            Đổi lại: camera phát liên tục (nóng hơn) và màn hình chính bị che. Bật thì 2 tuỳ chọn thời gian bên
            dưới không còn tác dụng. Mặc định của thiết kế là tắt (IOT_NODE_NETWORK §5.4: chỉ kéo luồng khi có
            người xem); bộ demo bật trong sdkconfig.defaults vì chưa bật cảm ứng.

    config GW_CAMERA_LIVE_ON_MOTION_S
        int "Tự mở xem trực tiếp khi camera báo chuyển động (giây, 0 = tắt)"
        range 0 300
        default 30
        help
            Camera cửa báo EVENT motion qua ESP-NOW → màn hình Gateway hiện luồng trực tiếp trong khoảng này, tính
            từ lúc lên hình. Có chuyển động tiếp thì gia hạn.

    config GW_CAMERA_LIVE_ON_BOOT_S
        int "Mở xem trực tiếp khi camera vừa vào Local AP sau khởi động (giây, 0 = tắt)"
        range 0 3600
        default 30
        help
            Kiểm tra nhanh đường hình Camera → Gateway khi chưa bật cảm ứng và chưa nối PIR. Chỉ chạy 1 lần
            sau mỗi lần khởi động Gateway; thời gian tính từ lúc lên hình.

    config GW_ESPNOW_ALLOW_UNENCRYPTED
        bool "[DEV] Cho peer ESP-NOW không mã hoá khi NVS thiếu LMK"
        default n
        help
            Chỉ dùng khi node/camera cũng bật tuỳ chọn [DEV] tương ứng. Bản demo/production phải tắt.

    config GW_DEV_ALLOW_PLAINTEXT
        bool "[DEV] Cho kết nối Server không TLS (mqtt://, http://)"
        default n
        help
            Hạ tầng hiện tại: Broker 2 chỉ nhận TLS (8883) nhưng nginx chỉ có cổng 80 (http). Bật để dùng đường
            dự phòng POST http://.../api/device/data khi dev. Không bao giờ tắt kiểm chứng chứng chỉ khi dùng TLS.

endmenu
