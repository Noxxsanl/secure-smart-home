# sdkconfig.defaults — ESP32-CAM AI-Thinker (docs/guides/ESP_IDF_BUILD.md §2.3)
# KHÔNG đặt SSID, mật khẩu, secret ở đây — file này được commit (ESP_IDF_BUILD §7.1).
# Sửa file này khi đã có sdkconfig thì phải xoá sdkconfig (hoặc chạy lại set-target) rồi build.
CONFIG_IDF_TARGET="esp32"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# PSRAM 4 MB chứa khung hình JPEG (fb_count = 2) và bộ đệm ảnh gửi Gateway
CONFIG_SPIRAM=y

# Bảng phân vùng riêng: 2 slot OTA + log (ESP_IDF_BUILD §4)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_node.csv"

# OTA: rollback nếu app mới không xác nhận boot thành công
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# app_main khởi tạo nhiều module
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# Header yêu cầu /stream có X-Device-Id, X-Timestamp, X-Signature (64 hex) + header của HTTP client Gateway
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
